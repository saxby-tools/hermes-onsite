<%#
  The footer, included by every layout. It shows the mark, says who
  made this and who did not, names the license, and links the pages
  the masthead leaves out, with the page's own Markdown on GitHub
  last. The mark's numbers are explained beside its styles.
-%>
<footer class="foot">
  <div class="foot__inner">
    <svg
      class="foot__mark mark"
      viewBox="0 0 64 64"
      role="img"
      aria-label="onsite"
    >
      <rect class="mark__tile" width="64" height="64" />
      <text class="mark__lit" x="3" y="46.25">o</text>
      <text class="mark__rest" x="30.92" y="46.25">n</text>
    </svg>
    <div class="foot__text">
      <p>
        onsite is a community plugin. It is not made or endorsed
        by Nous Research, and it is not part of Hermes.
      </p>
      <p>
        Free software under AGPL-3.0-or-later. Built by Claude Code
        from a brief. Every commit says so.
      </p>
    </div>
    <nav class="foot__nav" aria-label="More pages">
      <a href="<%= root %>DECISIONS.html">Decisions</a>
      <a href="<%= root %>docs/findings.html">Phase 0 findings</a>
      <a href="<%= root %>docs/upstream.html">Upstream drafts</a>
      <a href="<%= root %>docs/design.html">Design system</a>
      <a href="https://github.com/NousResearch/hermes-agent">Hermes</a>
      <a href="<%= source %>">This page in Markdown</a>
    </nav>
  </div>
</footer>
