<%#
  The masthead, included by every layout: the wordmark, two links,
  the theme picker and the Source button. It is one row at every
  width and never wraps, so the bar under it can stick at a known
  height. When space is tight the Source button keeps its icon and
  drops its word.

  The two links are the two parts of the site: the docs, which start
  at the front page, and the guide. The link for the part this page
  is in is marked with `aria-current`: "page" when the link is this
  very page, "true" when the page sits under it.

  The theme picker has three choices, each an icon with a spoken
  name. It is hidden until the script is running, because it does
  nothing without it. The styles are under "Masthead" in
  site/static/onsite.css.

  Every icon is copied as it is from GitHub's Octicons set, which is
  under the MIT license: mark-github-16, device-desktop-16, sun-16
  and moon-16. The license text is in site/static/icons/. Each path
  is one long line because it must not be changed.
-%>
<%
  const current = sectionFront ? "page" : "true";
  const mark = ` aria-current="${current}"`;
  const docsCurrent = section === "docs" ? mark : "";
  const guideCurrent = section === "guide" ? mark : "";
-%>
<a class="skip" href="#main">Skip to the page</a>
<header class="top">
  <div class="top__inner">
    <a
      class="top__home top__wordmark wordmark"
      href="<%= root %>"
      aria-label="onsite, the front page"
    ><span class="wordmark__lit">o</span>nsite</a>
    <nav class="top__nav" aria-label="Main">
      <a class="top__link" href="<%= root %>"<%- docsCurrent %>>Docs</a>
      <a
        class="top__link"
        href="<%= root %>docs/guide/"<%- guideCurrent %>
      >Guide</a>
    </nav>
    <div
      class="theme-toggle"
      role="group"
      aria-label="Theme"
      data-theme-toggle
      hidden
    >
      <button
        class="theme-toggle__option"
        type="button"
        data-theme-choice="system"
        aria-pressed="true"
        aria-label="Follow the system's theme"
        title="Follow the system's theme"
      >
        <svg class="top__icon" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M14.25 1c.966 0 1.75.784 1.75 1.75v7.5A1.75 1.75 0 0 1 14.25 12h-3.727c.099 1.041.52 1.872 1.292 2.757A.752.752 0 0 1 11.25 16h-6.5a.75.75 0 0 1-.565-1.243c.772-.885 1.192-1.716 1.292-2.757H1.75A1.75 1.75 0 0 1 0 10.25v-7.5C0 1.784.784 1 1.75 1ZM1.75 2.5a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h12.5a.25.25 0 0 0 .25-.25v-7.5a.25.25 0 0 0-.25-.25ZM9.018 12H6.982a5.72 5.72 0 0 1-.765 2.5h3.566a5.72 5.72 0 0 1-.765-2.5Z" />
        </svg>
      </button>
      <button
        class="theme-toggle__option"
        type="button"
        data-theme-choice="light"
        aria-pressed="false"
        aria-label="Light theme"
        title="Light theme"
      >
        <svg class="top__icon" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M8 12a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm0-1.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Zm5.657-8.157a.75.75 0 0 1 0 1.061l-1.061 1.06a.749.749 0 0 1-1.275-.326.749.749 0 0 1 .215-.734l1.06-1.06a.75.75 0 0 1 1.06 0Zm-9.193 9.193a.75.75 0 0 1 0 1.06l-1.06 1.061a.75.75 0 1 1-1.061-1.06l1.06-1.061a.75.75 0 0 1 1.061 0ZM8 0a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0V.75A.75.75 0 0 1 8 0ZM3 8a.75.75 0 0 1-.75.75H.75a.75.75 0 0 1 0-1.5h1.5A.75.75 0 0 1 3 8Zm13 0a.75.75 0 0 1-.75.75h-1.5a.75.75 0 0 1 0-1.5h1.5A.75.75 0 0 1 16 8Zm-8 5a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0v-1.5A.75.75 0 0 1 8 13Zm3.536-1.464a.75.75 0 0 1 1.06 0l1.061 1.06a.75.75 0 0 1-1.06 1.061l-1.061-1.06a.75.75 0 0 1 0-1.061ZM2.343 2.343a.75.75 0 0 1 1.061 0l1.06 1.061a.751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018l-1.06-1.06a.75.75 0 0 1 0-1.06Z" />
        </svg>
      </button>
      <button
        class="theme-toggle__option"
        type="button"
        data-theme-choice="dark"
        aria-pressed="false"
        aria-label="Dark theme"
        title="Dark theme"
      >
        <svg class="top__icon" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M9.598 1.591a.749.749 0 0 1 .785-.175 7.001 7.001 0 1 1-8.967 8.967.75.75 0 0 1 .961-.96 5.5 5.5 0 0 0 7.046-7.046.75.75 0 0 1 .175-.786Zm1.616 1.945a7 7 0 0 1-7.678 7.678 5.499 5.499 0 1 0 7.678-7.678Z" />
        </svg>
      </button>
    </div>
    <a
      class="top__link top__link-button"
      href="https://github.com/saxby-tools/hermes-onsite"
    >
      <svg class="top__icon" viewBox="0 0 16 16" aria-hidden="true">
        <path d="M6.766 11.328c-2.063-.25-3.516-1.734-3.516-3.656 0-.781.281-1.625.75-2.188-.203-.515-.172-1.609.063-2.062.625-.078 1.468.25 1.968.703.594-.187 1.219-.281 1.985-.281.765 0 1.39.094 1.953.265.484-.437 1.344-.765 1.969-.687.218.422.25 1.515.046 2.047.5.593.766 1.39.766 2.203 0 1.922-1.453 3.375-3.547 3.64.531.344.89 1.094.89 1.954v1.625c0 .468.391.734.86.547C13.781 14.359 16 11.53 16 8.03 16 3.61 12.406 0 7.984 0 3.563 0 0 3.61 0 8.031a7.88 7.88 0 0 0 5.172 7.422c.422.156.828-.125.828-.547v-1.25c-.219.094-.5.156-.75.156-1.031 0-1.64-.562-2.078-1.609-.172-.422-.36-.672-.719-.719-.187-.015-.25-.093-.25-.187 0-.188.313-.328.625-.328.453 0 .844.281 1.25.86.313.452.64.655 1.031.655s.641-.14 1-.5c.266-.265.47-.5.657-.656" />
      </svg>
      <span class="top__word">Source</span>
    </a>
  </div>
</header>
