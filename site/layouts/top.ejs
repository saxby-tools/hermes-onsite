<%#
  The masthead, included by every layout: the wordmark, the links to
  the front page's main sections, and the theme toggle. The toggle
  has three choices and is boxed, so it reads as a control and not as
  one more link. It is hidden until the script is running, because it
  does nothing without it. Its styles are under "Masthead" in
  site/static/onsite.css.

  The icon in the Source button is GitHub's own mark, copied as it is
  from GitHub's Octicons set (mark-github-16), which is under the MIT
  license. The license text is in site/static/icons/. The path is one
  long line because it must not be changed.
-%>
<a class="skip" href="#main">Skip to the page</a>
<header class="top">
  <div class="top__inner">
    <a
      class="top__home top__wordmark wordmark"
      href="<%= root %>"
      aria-label="onsite, the front page"
    ><span class="wordmark__lit">o</span>nsite</a>
    <nav class="top__nav" aria-label="Main">
      <a class="top__link" href="<%= root %>docs/guide/">Guide</a>
      <a class="top__link" href="<%= root %>#install">Install</a>
      <a class="top__link" href="<%= root %>#use">Use</a>
      <a class="top__link" href="<%= root %>#limits">Limits</a>
      <a class="top__link" href="<%= root %>#what-is-tested">Tested</a>
    </nav>
    <div
      class="theme-toggle"
      role="group"
      aria-label="Theme"
      data-theme-toggle
      hidden
    >
      <button
        class="theme-toggle__option"
        type="button"
        data-theme-choice="system"
        aria-pressed="true"
      >System</button>
      <button
        class="theme-toggle__option"
        type="button"
        data-theme-choice="light"
        aria-pressed="false"
      >Light</button>
      <button
        class="theme-toggle__option"
        type="button"
        data-theme-choice="dark"
        aria-pressed="false"
      >Dark</button>
    </div>
    <a
      class="top__link top__link-button"
      href="https://github.com/saxby-tools/hermes-onsite"
    >
      <svg class="top__icon" viewBox="0 0 16 16" aria-hidden="true">
        <path d="M6.766 11.328c-2.063-.25-3.516-1.734-3.516-3.656 0-.781.281-1.625.75-2.188-.203-.515-.172-1.609.063-2.062.625-.078 1.468.25 1.968.703.594-.187 1.219-.281 1.985-.281.765 0 1.39.094 1.953.265.484-.437 1.344-.765 1.969-.687.218.422.25 1.515.046 2.047.5.593.766 1.39.766 2.203 0 1.922-1.453 3.375-3.547 3.64.531.344.89 1.094.89 1.954v1.625c0 .468.391.734.86.547C13.781 14.359 16 11.53 16 8.03 16 3.61 12.406 0 7.984 0 3.563 0 0 3.61 0 8.031a7.88 7.88 0 0 0 5.172 7.422c.422.156.828-.125.828-.547v-1.25c-.219.094-.5.156-.75.156-1.031 0-1.64-.562-2.078-1.609-.172-.422-.36-.672-.719-.719-.187-.015-.25-.093-.25-.187 0-.188.313-.328.625-.328.453 0 .844.281 1.25.86.313.452.64.655 1.031.655s.641-.14 1-.5c.266-.265.47-.5.657-.656" />
      </svg>
      Source
    </a>
  </div>
</header>
