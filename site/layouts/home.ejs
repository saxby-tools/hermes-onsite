<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title><%= title %></title>
<%- include("head.ejs") %>
</head>
<%
  // The README renders flat. Everything before the first h2 is the
  // hero; each h2 starts a section. The headings already carry the
  // anchors GitHub gives them, so the same #links work in both
  // places. The contents list is built from them, the one thing this
  // page adds that the Markdown does not hold.
  const [intro, ...parts] = content.split(/(?=<h2[\s>])/);
  const sections = parts.map((part) => {
    const heading = part.match(/<h2 id="([^"]*)">([\s\S]*?)<\/h2>/);

    return {
      id: heading[1],
      title: heading[2],
      body: part.replace(heading[0], "").trim(),
    };
  });
-%>
<body class="layout-home">
<%- include("top.ejs") -%>
<main id="main">

  <header class="hero">
    <div class="hero__inner">
      <div class="hero__text prose">
        <p class="label hero__kicker">
          A community plugin for the Hermes agent
        </p>
<%- intro.trim() %>
      </div>

      <figure class="plate hero__plate">
        <img
          class="plate__art"
          src="<%= root %>docs/brand/plate-table.png"
          alt="An engraving drawn in broken blue lines. Two travellers
sit at a table by lamplight. One wears a winged hat. An old woman
waits on them."
          width="1680"
          height="1120"
        >
        <figcaption class="plate__caption">
          <span class="plate__number">Plate I · At your table</span>
          Jupiter and Mercury at the house of Philemon and Baucis.
          Hendrik Goudt, after Adam Elsheimer, 1613. The gods went
          door to door as strangers. One old couple let them in.
          Mercury, who is Hermes, wears the winged hat.
        </figcaption>
      </figure>
    </div>
  </header>

<%- include("contents.ejs", { sections }) -%>
<% for (const section of sections) { -%>

  <section class="section" aria-labelledby="<%= section.id %>">
    <div class="section__inner prose">
      <h2 class="section__title" id="<%= section.id %>">
        <%- section.title %>
      </h2>
<%- section.body %>
    </div>
  </section>
<% } -%>

</main>
<%- include("foot.ejs") -%>
</body>
</html>
