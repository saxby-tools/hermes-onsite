<div class="ui ui-settings">
  <p class="ui__title">Machines</p>
  <div class="ui__form">
    <p class="ui__field">
      <span class="ui__label">Name</span>
      <span class="ui__input">laptop</span>
    </p>
    <p class="ui__field">
      <span class="ui__label">Where it is</span>
      <span class="ui__select">Another machine, over SSH</span>
    </p>
    <p class="ui__field">
      <span class="ui__label">Address</span>
      <span class="ui__input">laptop.example</span>
    </p>
    <p class="ui__field">
      <span class="ui__label">Log in as</span>
      <span class="ui__input">you</span>
    </p>
    <p class="ui__field">
      <span class="ui__label">Port (leave empty for 22)</span>
      <span class="ui__input ui__input-empty">22</span>
    </p>
    <p class="ui__field">
      <span class="ui__label">
        Key file (leave empty to use your SSH setup)
      </span>
      <span class="ui__input ui__input-empty">&nbsp;</span>
    </p>
    <p class="ui__field">
      <span class="ui__label">
        Folders that belong to it, one a line
      </span>
      <span class="ui__input ui__input-tall">/home/you/</span>
    </p>
    <p class="ui__check">
      <span class="ui__box">✓</span>
      Use it when no folder rule matches
    </p>
    <p class="ui__hint">Connected in 42 ms.</p>
    <p class="ui__line">
      <span class="ui__button ui__button-main">Save</span>
      <span class="ui__button">Test connection</span>
      <span class="ui__button">Cancel</span>
    </p>
  </div>
</div>
