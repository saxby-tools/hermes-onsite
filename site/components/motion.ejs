<%#
  Two bars that slide when pointed at or focused, one at each speed
  token: <!-- onsite:motion /-->
-%>
<div class="motion">
  <button class="motion__track motion__track-fast" type="button">
    <span class="motion__dot"></span>
    <code>--motion-fast</code>
  </button>
  <button class="motion__track motion__track-slow" type="button">
    <span class="motion__dot"></span>
    <code>--motion-slow</code>
  </button>
</div>
