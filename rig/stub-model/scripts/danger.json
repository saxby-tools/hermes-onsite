{
  "about": "Phase 1: does a gated command reach the approval prompt?",
  "steps": [
    {
      "tool": "terminal",
      "args": {
        "command": "mkdir -p hands-rig-victim && touch hands-rig-victim/keep"
      }
    },
    {
      "tool": "terminal",
      "args": {"command": "rm -rf hands-rig-victim"}
    },
    {
      "tool": "terminal",
      "args": {
        "command": "test -e hands-rig-victim/keep && echo SURVIVED || echo GONE"
      }
    },
    {
      "text": "Done."
    }
  ]
}
